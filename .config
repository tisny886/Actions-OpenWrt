CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_cudy_tr3000-256mb-v1=y

# 内核设置
CONFIG_KERNEL_BUILD_DOMAIN=""
CONFIG_KERNEL_BUILD_HOST=""
CONFIG_KERNEL_BUILD_USER=""
CONFIG_KERNEL_DEBUG_INFO=n
CONFIG_KERNEL_DEBUG_INFO_BTF=n
CONFIG_KERNEL_KALLSYMS=n
CONFIG_KERNEL_COREDUMP=y
CONFIG_KERNEL_FS_POSIX_ACL=y
CONFIG_KERNEL_SECURITY_SELINUX=n
CONFIG_KERNEL_DEFAULT_PREEMPTION=y
CONFIG_KERNEL_TCP_BBR=y

# Base system
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_BUSYBOX_CONFIG_FEATURE_SYSLOG=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_dropbear=y

# ========== firewall3 iptables‑legacy，关闭fw4/nftables ==========
CONFIG_PACKAGE_firewall4=n
CONFIG_PACKAGE_fw4=n
CONFIG_PACKAGE_nftables=n
CONFIG_PACKAGE_kmod-nft-core=n
CONFIG_PACKAGE_firewall=y
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_iptables-legacy=y
CONFIG_PACKAGE_ip6tables-legacy=y
CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_kmod-ipt-conntrack=y
CONFIG_PACKAGE_kmod-ipt-nat=y
# =================================================================

# LuCI基础与主题
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_luci-lib-nixio=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-argon=y

# subconverter订阅转换
CONFIG_PACKAGE_subconverter=y
CONFIG_PACKAGE_luci-app-subconverter=y

# ========== TurboACC：仅BBR + FullCone‑NAT，去掉Shortcut‑FE ==========
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_shortcut-fe=n
CONFIG_PACKAGE_kmod-shortcut-fe=n
# =====================================================================

# SmartDNS
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y

# MosDNS
CONFIG_PACKAGE_mosdns=y
CONFIG_PACKAGE_luci-app-mosdns=y

# OpenClash
CONFIG_PACKAGE_luci-app-openclash=y

# ZRAM内存交换
CONFIG_PACKAGE_luci-app-zram=y
CONFIG_PACKAGE_zram-swap=y

# 自动挂载
CONFIG_PACKAGE_luci-app-mountd=y
CONFIG_PACKAGE_mountd=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-vfat=y

# USB支持、USB网络共享(RNDIS)
CONFIG_PACKAGE_kmod-usb-ohci=n
CONFIG_PACKAGE_kmod-usb-uhci=n
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y

# frpc内网穿透客户端
CONFIG_PACKAGE_frpc=y
CONFIG_PACKAGE_luci-app-frpc=y

# ttyd网页终端
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y

# UPnP
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_upnp=y

# KMS激活服务
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_vlmcsd=y

# ZeroTier
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y

# Ocserv 思科VPN
CONFIG_PACKAGE_ocserv=y
CONFIG_PACKAGE_luci-app-ocserv=y

# Easytier点对点组网
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-app-easytier=y

# WAN MAC修改
CONFIG_PACKAGE_luci-app-macvlan=y
CONFIG_PACKAGE_luci-app-wol=y

# socat
CONFIG_PACKAGE_socat=y

# 网络共享(Samba)
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_samba4-server=y

# 网络工具
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_ncat=y

# 中文翻译
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
CONFIG_PACKAGE_luci-i18n-subconverter-zh-cn=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-mosdns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y
CONFIG_PACKAGE_luci-i18n-zram-zh-cn=y
CONFIG_PACKAGE_luci-i18n-frpc-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ocserv-zh-cn=y
CONFIG_PACKAGE_luci-i18n-easytier-zh-cn=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y

# 固件镜像
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_PERSISTENT=n
CONFIG_TARGET_IMAGES_GZIP=y
